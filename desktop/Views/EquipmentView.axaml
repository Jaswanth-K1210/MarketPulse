<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarketPulse.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="MarketPulse.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="MTU Fleet Health" FontSize="22" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#9ca3af" Margin="0,4,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Content="↻  Refresh" Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsLoading}" Padding="14,8"
              Background="#6366f1" Foreground="White"/>
    </Grid>

    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" Margin="0,0,0,8"/>

    <!-- Mini KPI strip -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" Margin="0,0,0,12">
      <Border Grid.Column="0" Background="#0f2d1f" CornerRadius="8" Margin="0,0,6,0" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="✓" Foreground="#34d399" FontSize="14" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Healthy" FontSize="10" Foreground="#9ca3af"/>
            <TextBlock Text="{Binding Healthy}" FontSize="18" FontWeight="Bold" Foreground="#34d399"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#2d2000" CornerRadius="8" Margin="0,0,6,0" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="⚠" Foreground="#fbbf24" FontSize="14" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Warning" FontSize="10" Foreground="#9ca3af"/>
            <TextBlock Text="{Binding Warning}" FontSize="18" FontWeight="Bold" Foreground="#fbbf24"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#2d0f0f" CornerRadius="8" Margin="0,0,6,0" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="🚨" FontSize="14" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Critical" FontSize="10" Foreground="#9ca3af"/>
            <TextBlock Text="{Binding Critical}" FontSize="18" FontWeight="Bold" Foreground="#f87171"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Background="#1e1e3f" CornerRadius="8" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Avg Score" FontSize="10" Foreground="#9ca3af"/>
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#a78bfa">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0}%">
                  <Binding Path="AverageScore"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Equipment DataGrid -->
    <DataGrid Grid.Row="3"
              ItemsSource="{Binding Units}"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              Background="#1a1a2e"
              RowBackground="#1a1a2e"
              Foreground="White"
              BorderThickness="0"
              CanUserSortColumns="True"
              CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Engine ID"     Binding="{Binding EngineId}"                Width="160"/>
        <DataGridTextColumn Header="Model"         Binding="{Binding Model}"                   Width="160"/>
        <DataGridTextColumn Header="Sector"        Binding="{Binding Sector}"                  Width="90"/>
        <DataGridTextColumn Header="Health %"      Binding="{Binding HealthScore}"             Width="80"/>
        <DataGridTextColumn Header="Status"        Binding="{Binding Status}"                  Width="90"/>
        <DataGridTextColumn Header="Op. Hours"     Binding="{Binding OperatingHours, StringFormat={}{0:N0}}" Width="100"/>
        <DataGridTextColumn Header="Next Service"  Binding="{Binding NextServiceFormatted}"    Width="120"/>
        <DataGridTextColumn Header="Active Alerts" Binding="{Binding AlertSummary}"            Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
