<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarketPulse.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="MarketPulse.Desktop.Views.AlertsView"
             x:DataType="vm:AlertsViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Supply Chain Alerts" FontSize="22" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#9ca3af" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SeverityFilter}"
                  Width="110" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding LimitFilter}"
                  Width="70" VerticalAlignment="Center"/>
        <Button Content="↻  Refresh" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsLoading}" Padding="14,8"
                Background="#6366f1" Foreground="White"/>
      </StackPanel>
    </Grid>

    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" Margin="0,0,0,8"/>

    <!-- Alerts DataGrid -->
    <DataGrid Grid.Row="2"
              ItemsSource="{Binding Alerts}"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              Background="#1a1a2e"
              RowBackground="#1a1a2e"
              Foreground="White"
              BorderThickness="0"
              CanUserSortColumns="True"
              CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Ticker"    Binding="{Binding Ticker}"     Width="80"/>
        <DataGridTextColumn Header="Severity"  Binding="{Binding Severity}"   Width="90"/>
        <DataGridTextColumn Header="Impact %"  Binding="{Binding ImpactPercent, StringFormat={}{0:+0.00;-0.00}}" Width="90"/>
        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:P0}}" Width="100"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}"  Width="160"/>
        <DataGridTextColumn Header="Source"    Binding="{Binding Source}"     Width="120"/>
      </DataGrid.Columns>
    </DataGrid>

  </Grid>
</UserControl>
