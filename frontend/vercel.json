{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": "@marketpulse_backend_url",
    "VITE_WS_URL": "@marketpulse_ws_url",
    "VITE_GOOGLE_CLIENT_ID": "@marketpulse_google_client_id"
  }
}
