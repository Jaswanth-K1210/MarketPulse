# ═══════════════════════════════════════════════════════════════
# MarketPulse-X Environment Variables
# cp .env.example .env  →  fill in your keys  →  python run.py
# ═══════════════════════════════════════════════════════════════

# ── LLM Tier 1: Groq (PRIMARY — free, fast) ──────────────────
# Sign up: console.groq.com  |  14,400 req/day free
GROQ_API_KEY=

# ── LLM Tier 2: OpenRouter (free deepseek + gemini models) ───
# Sign up: openrouter.ai  |  daily free tier
OPENROUTER_API_KEY=


# LLM routing mode: auto | groq | openrouter | gemini | ollama
LLM_MODE=auto

# ── LLM Tier 3: Gemini Flash (1M tokens/day free) ────────────
# Get key: aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── LLM Tier 4: Ollama (local dev, offline testing) ──────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── News APIs (all free tiers) ───────────────────────────────
NEWSAPI_KEY=            # newsapi.org — 100 req/day
NEWSDATA_IO_KEY=        # newsdata.io — 200 req/day
FINNHUB_API_KEY=        # finnhub.io  — 60 req/min
GNEWS_API_KEY=          # gnews.io    — 100 req/day
MEDIASTACK_API_KEY=     # mediastack.com — 500 req/month

# ── MongoDB Atlas (users, profiles, agent memory) ────────────
# Sign up: mongodb.com/cloud/atlas  |  free M0 cluster
# Format: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
MONGODB_DB_NAME=marketpulse

# ── Alpaca Market Data (real-time stock prices + WebSocket) ───
# Free tier: paper trading account at alpaca.markets gives IEX data
# Sign up → https://app.alpaca.markets/signup  |  Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Database (SQLite — pipeline data only) ────────────────────
# Dev: leave blank (auto SQLite in app/data/)
DATABASE_URL=

# Production Supabase (supabase.com free tier):
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# ── Cache ────────────────────────────────────────────────────
# Dev: docker-compose starts Redis automatically
REDIS_URL=redis://localhost:6379

# Production Upstash (upstash.com free — 10K commands/day):
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# ── Server ───────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# ── Auth ─────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Google OAuth (optional — enables "Sign in with Google") ──
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add your frontend URL to Authorised JavaScript origins
# 4. Copy the Client ID below
GOOGLE_CLIENT_ID=890460096986-f202nhr4hdmpcrrdblf758f2fd3spfc5.apps.googleusercontent.com

# ── Macro / FRED (free) ───────────────────────────────────────
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Conflict Data (free academic access) ─────────────────────
# Register: https://acleddata.com/acleddatanerd/
ACLED_API_KEY=
ACLED_EMAIL=

# ── Frontend WebSocket (set to your backend URL in production) ─
# Dev:        ws://localhost:8000/ws
# Production: wss://marketpulse-x.onrender.com/ws
VITE_WS_URL=ws://localhost:8000/ws
